# ── RPC / Network ─────────────────────────────────────────────
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL_TESTNET=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL_LOCAL=http://localhost:8545

# ── Wallet ────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Contracts ─────────────────────────────────────────────────
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://triax:triax_pass@localhost:5432/triax_db
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars

# ── Next.js public vars (exposed to browser) ──────────────────
NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
